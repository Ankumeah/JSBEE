package components

templ navBar(siteName string, current string) {
	<header
		class="sticky top-0 z-40 border-b border-[#DDD5C2] bg-[#FAF7EF]/95 backdrop-blur"
		x-data="{ open: false }"
	>
		<nav class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6">
			<a href="/" class="flex items-center gap-2.5 font-serif text-xl font-semibold tracking-tight text-[#16211B] sm:text-2xl">
				<img src="/favicon.png" alt="JSBEE logo" class="h-8 w-8 rounded-[3px] object-cover"/>
				{ siteName }
			</a>
			<button
				type="button"
				class="inline-flex items-center rounded-[3px] border border-[#DDD5C2] px-3 py-1.5 text-sm font-medium text-stone-700 md:hidden"
				@click="open = !open"
				:aria-expanded="open.toString()"
				aria-controls="site-menu"
			>
				Menu
			</button>
			<ul
				id="site-menu"
				class="hidden items-center gap-7 text-sm font-medium text-stone-600 md:flex"
			>
				<li>
					<a
						href="/"
						class={ "hover:text-[#33523B]", templ.KV("text-[#33523B] underline decoration-[#33523B] decoration-2 underline-offset-8", current == "home") }
					>
						Home
					</a>
				</li>
				<li>
					<a
						href="/volumes"
						class={ "hover:text-[#33523B]", templ.KV("text-[#33523B] underline decoration-[#33523B] decoration-2 underline-offset-8", current == "volumes") }
					>
						Volumes
					</a>
				</li>
				<li>
					<a
						href="/blog"
						class={ "hover:text-[#33523B]", templ.KV("text-[#33523B] underline decoration-[#33523B] decoration-2 underline-offset-8", current == "blog") }
					>
						Blog
					</a>
				</li>
				<li>
					<a
						href="/about"
						class={ "hover:text-[#33523B]", templ.KV("text-[#33523B] underline decoration-[#33523B] decoration-2 underline-offset-8", current == "about") }
					>
						About
					</a>
				</li>
				<li>
					<a
						href="/team"
						class={ "hover:text-[#33523B]", templ.KV("text-[#33523B] underline decoration-[#33523B] decoration-2 underline-offset-8", current == "team") }
					>
						Team
					</a>
				</li>
				<li>
					<a
						href="/contact"
						class={ "hover:text-[#33523B]", templ.KV("text-[#33523B] underline decoration-[#33523B] decoration-2 underline-offset-8", current == "contact") }
					>
						Contact
					</a>
				</li>
				<li>
					<a
						href="/volumes#browse"
						class="inline-flex items-center gap-1.5 hover:text-[#33523B]"
						aria-label="Search research"
					>
						<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z"/>
						</svg>
						<span class="sr-only">Search research</span>
					</a>
				</li>
			<li>
				if current == "profile" {
					<button
						type="button"
						class="inline-flex items-center rounded-[3px] bg-[#33523B] px-4 py-1.5 text-sm font-semibold text-[#F5F6EF] hover:bg-[#26402D]"
						onclick="showToast('Already at Your Profile!');"
					>
						My Profile
					</button>
				} else {
					<button
						type="button"
						class="inline-flex items-center rounded-[3px] bg-[#33523B] px-4 py-1.5 text-sm font-semibold text-[#F5F6EF] hover:bg-[#26402D]"
						onclick="
							var fresh = !getFirebaseUuid();
							showToast('Waiting for login...');
							ensureSignedIn().then(function() {
								hideToast();
								if (fresh) {
									localStorage.setItem('jsbee_welcome', '1');
								}
								window.location.href = '/profile';
							}).catch(function(err) {
								hideToast();
								if (err && err.code === 'auth/popup-closed-by-user') {
									return;
								}
								showAuthFailedToast('Sign in failed: ' + err.message);
							});
						"
					>
						My Profile
					</button>
				}
			</li>
			</ul>
		</nav>
		<ul
			id="site-menu-mobile"
			class="space-y-1 border-t border-[#DDD5C2] px-4 py-3 text-sm font-medium md:hidden"
			x-cloak
			x-show="open"
			x-transition
		>
			<li>
				<a href="/" class="block rounded px-2 py-2 hover:bg-[#F2EDE1]">Home</a>
			</li>
			<li>
				<a href="/volumes" class="block rounded px-2 py-2 hover:bg-[#F2EDE1]">Volumes</a>
			</li>
			<li>
				<a href="/blog" class="block rounded px-2 py-2 hover:bg-[#F2EDE1]">Blog</a>
			</li>
			<li>
				<a href="/about" class="block rounded px-2 py-2 hover:bg-[#F2EDE1]">About</a>
			</li>
			<li>
				<a href="/team" class="block rounded px-2 py-2 hover:bg-[#F2EDE1]">Team</a>
			</li>
			<li>
				<a href="/contact" class="block rounded px-2 py-2 hover:bg-[#F2EDE1]">Contact</a>
			</li>
			<li>
				<a href="/volumes#browse" class="block rounded px-2 py-2 hover:bg-[#F2EDE1]">Search research</a>
			</li>
			<li>
				if current == "profile" {
					<button
						type="button"
						class="mt-1 block w-full rounded-[3px] bg-[#33523B] px-3 py-2.5 text-left text-sm font-semibold text-[#F5F6EF]"
						onclick="showToast('Already at Your Profile!');"
					>
						My Profile
					</button>
				} else {
					<button
						type="button"
						class="mt-1 block w-full rounded-[3px] bg-[#33523B] px-3 py-2.5 text-left text-sm font-semibold text-[#F5F6EF]"
						onclick="
							var fresh = !getFirebaseUuid();
							showToast('Waiting for login...');
							ensureSignedIn().then(function() {
								hideToast();
								if (fresh) {
									localStorage.setItem('jsbee_welcome', '1');
								}
								window.location.href = '/profile';
							}).catch(function(err) {
								hideToast();
								if (err && err.code === 'auth/popup-closed-by-user') {
									return;
								}
								showAuthFailedToast('Sign in failed: ' + err.message);
							});
						"
					>
						My Profile
					</button>
				}
			</li>
		</ul>
	</header>
}
