package components

import (
	"github.com/Ankumeah/JSBEE/backend/internal/provider"
)

var paperInfo = pageInfo{
	title:       "Paper",
	description: "Paper details",
}

templ paperPage() {
	<div class="flex min-h-screen flex-col">
		@navBar(provider.SiteName, "")
		<header class="jsbee-band bg-[#16211B]">
			<div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-14">
				<p id="paper-kicker" class="font-serif text-lg italic text-[#B9C2B2]">From the library</p>
				<h1 id="paper-title" class="mt-3 font-serif text-4xl font-semibold leading-tight text-[#F2F3EA] sm:text-5xl">Paper</h1>
				<p id="paper-byline" class="mt-4 hidden text-sm leading-relaxed text-[#B9C2B2]"></p>
			</div>
		</header>
		<main class="mx-auto w-full max-w-3xl flex-1 px-4 py-10 sm:px-6">
			<div id="paper-loading" class="mt-8 text-center text-sm text-stone-500">Loading paper...</div>
			<div id="paper-error" class="mt-8 hidden text-center text-sm text-[#7F1D1D]"></div>
			<div
				id="paper-card"
				class="mt-8 hidden border-y border-[#DDD5C2] py-6"
			>
				<dl class="space-y-4 text-sm">
					<div class="flex items-center justify-between gap-4 border-b border-stone-100 pb-3">
						<dt class="font-medium text-stone-500">Author</dt>
						<dd>
							<a id="paper-author-link" class="hidden text-sm font-medium text-[#33523B] hover:underline hover:underline-offset-4"></a>
							<span id="paper-author-unknown" class="hidden text-sm text-stone-500">Unknown</span>
						</dd>
					</div>
					<div class="flex items-center justify-between gap-4 border-b border-stone-100 pb-3">
						<dt class="font-medium text-stone-500">Number</dt>
						<dd id="paper-number" class="text-stone-900"></dd>
					</div>
					<div class="flex items-center justify-between gap-4 border-b border-stone-100 pb-3">
						<dt class="font-medium text-stone-500">Appears in</dt>
						<dd id="paper-context" class="text-stone-900"></dd>
					</div>
					<div class="flex items-center justify-between gap-4 border-b border-stone-100 pb-3">
						<dt class="font-medium text-stone-500">Status</dt>
						<dd id="paper-status" class="text-stone-900"></dd>
					</div>
					<div class="flex items-center justify-between gap-4">
						<dt class="font-medium text-stone-500">Reference</dt>
						<dd id="paper-uuid" class="font-mono text-xs text-stone-500"></dd>
					</div>
				</dl>
				<a
					id="paper-read-link"
					href="#"
					class="jsbee-btn mt-6 hidden items-center rounded-[3px] bg-[#33523B] px-6 py-3 text-sm font-bold text-[#F5F6EF] hover:bg-[#26402D]"
				>
					Read research
				</a>
				<p id="paper-file-empty" class="mt-6 hidden text-sm text-stone-500">No readable file is attached to this paper yet.</p>
			</div>
			<section id="paper-related" class="mt-12 hidden">
				<h2 class="border-t border-[#DDD5C2] pt-5 font-serif text-2xl font-semibold text-stone-900">Related research</h2>
				<ul id="paper-related-list" class="mt-2"></ul>
			</section>
			<a
				id="paper-back-link"
				href="/volumes"
				class="mt-8 inline-block rounded-[3px] border border-[#DDD5C2] px-4 py-2.5 text-sm font-medium text-stone-700 transition-colors hover:bg-[#F2EDE1]"
			>
				View all volumes
			</a>
		</main>
		@siteFooter(provider.SiteName)
		<script>
			(function() {
				var uuidPattern = /^[0-9a-fA-F-]{36}$/;

				function safeUUID(uuid) {
					return typeof uuid === 'string' && uuidPattern.test(uuid) ? uuid : null;
				}

				function el(tag, className, text) {
					var node = document.createElement(tag);
					if (className) {
						node.className = className;
					}
					if (text != null) {
						node.textContent = text;
					}
					return node;
				}

				function statusLabel(paper) {
					if (paper.number != null) {
						return 'Published';
					}
					if (paper.reviewed) {
						return 'Reviewed';
					}
					return 'Pending review';
				}

				function relatedRow(paper) {
					var li = el('li', 'border-b border-[#E7E0CF] last:border-0');
					var link = el('a', 'jsbee-row-hover flex min-w-0 flex-1 items-baseline gap-3 px-3 py-4');
					link.href = '/paper?uuid=' + encodeURIComponent(paper.uuid);
					if (paper.number != null) {
						link.appendChild(el('span', 'shrink-0 text-xs font-semibold text-[#33523B]', '№ ' + paper.number));
					}
					link.appendChild(el('span', 'font-serif text-lg font-medium text-stone-900', paper.title || 'Untitled'));
					li.appendChild(link);
					return li;
				}

				function loadRelated(currentUUID) {
					fetch('/api/v1/paper/volumes')
						.then(function(resp) {
							return checkApiResponse(resp, 'Failed to load volumes');
						}).then(function(resp) {
							return resp.json();
						}).then(function(data) {
							var volumes = (data && Array.isArray(data.volumes)) ? data.volumes : [];
							// Papers carry no volume reference, so locate the
							// current paper first, then gather neighbours.
							var context = null;
							volumes.forEach(function(volume) {
								((volume && volume.issues) || []).forEach(function(issue) {
									((issue && issue.papers) || []).forEach(function(paper) {
										if (paper.uuid === currentUUID) {
											context = { volume: volume.number, issue: issue.number };
										}
									});
								});
							});
							var sameIssue = [];
							var sameVolume = [];
							var fallback = [];
							volumes.forEach(function(volume) {
								((volume && volume.issues) || []).forEach(function(issue) {
									((issue && issue.papers) || []).forEach(function(paper) {
										if (!safeUUID(paper.uuid) || paper.uuid === currentUUID) {
											return;
										}
										if (context && volume.number === context.volume && issue.number === context.issue) {
											sameIssue.push(paper);
										} else if (context && volume.number === context.volume) {
											sameVolume.push(paper);
										} else {
											fallback.push(paper);
										}
									});
								});
							});
							if (context) {
								document.getElementById('paper-context').textContent =
									'Volume ' + context.volume + ', Issue ' + context.issue;
								document.getElementById('paper-kicker').textContent =
									'Volume ' + context.volume + ', Issue ' + context.issue;
							} else {
								document.getElementById('paper-context').textContent = 'Not assigned yet';
							}
							var picks = sameIssue.concat(sameVolume, fallback).slice(0, 4);
							if (!picks.length) {
								return;
							}
							var section = document.getElementById('paper-related');
							var list = document.getElementById('paper-related-list');
							picks.forEach(function(paper) {
								list.appendChild(relatedRow(paper));
							});
							section.classList.remove('hidden');
						}).catch(function() {});
				}

				function initPaper() {
					var params = new URLSearchParams(window.location.search);
					var uuid = params.get('uuid');
					if (params.get('from') === 'review') {
						var backLink = document.getElementById('paper-back-link');
						backLink.href = '/review';
						backLink.textContent = 'Back to review dashboard';
					}
					var loading = document.getElementById('paper-loading');
					var errorEl = document.getElementById('paper-error');
					var card = document.getElementById('paper-card');

					if (!uuid) {
						loading.classList.add('hidden');
						errorEl.textContent = 'No paper specified.';
						errorEl.classList.remove('hidden');
						return;
					}

					fetch('/api/v1/paper/' + encodeURIComponent(uuid))
						.then(function(resp) {
							return checkApiResponse(resp, 'Failed to load paper');
						})
						.then(function(resp) {
							return resp.json();
						})
						.then(function(data) {
							if (!data || !data.paper) {
								throw new Error('Paper not found');
							}
							var paper = data.paper;
							document.getElementById('paper-title').textContent = paper.title;
							document.title = paper.title;
							if (paper.owner_uuid) {
								var authorLink = document.getElementById('paper-author-link');
								authorLink.href = '/author?uuid=' + encodeURIComponent(paper.owner_uuid);
								fetch('/api/v1/user?uuid=' + encodeURIComponent(paper.owner_uuid))
									.then(function(resp) {
										return checkApiResponse(resp, 'Failed to load author');
									}).then(function(resp) {
										return resp.json();
									}).then(function(authorData) {
										var name = (authorData && authorData.user && authorData.user.name) || 'Unknown author';
										authorLink.textContent = name;
										authorLink.classList.remove('hidden');
										document.getElementById('paper-byline').textContent = 'By ' + name;
										document.getElementById('paper-byline').classList.remove('hidden');
									}).catch(function() {
										authorLink.textContent = 'Unknown author';
										authorLink.classList.remove('hidden');
									});
							} else {
								document.getElementById('paper-author-unknown').classList.remove('hidden');
							}
							document.getElementById('paper-number').textContent =
								paper.number != null ? '№ ' + paper.number : 'Not assigned yet';
							document.getElementById('paper-status').textContent = statusLabel(paper);
							if (paper.filename && data.file_url) {
								var read = document.getElementById('paper-read-link');
								read.href = data.file_url;
								read.classList.remove('hidden');
								read.classList.add('inline-flex');
							} else {
								document.getElementById('paper-file-empty').classList.remove('hidden');
							}
							document.getElementById('paper-uuid').textContent = paper.uuid;
							loading.classList.add('hidden');
							errorEl.classList.add('hidden');
							card.classList.remove('hidden');
							loadRelated(paper.uuid);
						})
						.catch(function(err) {
							loading.classList.add('hidden');
							errorEl.textContent = 'Failed to load paper: ' + err.message;
							errorEl.classList.remove('hidden');
						});
				}
				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', initPaper);
				} else {
					initPaper();
				}
			})();
		</script>
	</div>
}

templ PaperPage(firebaseClientConfig map[string]any) {
	@base(paperInfo, paperPage(), firebaseClientConfig)
}
