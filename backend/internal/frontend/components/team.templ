package components

import (
	"github.com/Ankumeah/JSBEE/backend/internal/database"
	"github.com/Ankumeah/JSBEE/backend/internal/provider"
)

var teamInfo = pageInfo{
	title:       "Our team",
	description: "JSBEE city leaders",
}

templ teamPage(leaders []database.User) {
	<div class="flex min-h-screen flex-col">
		@navBar(provider.SiteName, "")
		<header class="jsbee-band bg-[#16211B]">
			<div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-14">
				<p class="font-serif text-lg italic text-[#C9A44A]">Who leads where</p>
				<h1 class="mt-3 font-serif text-4xl font-semibold text-[#F2F3EA] sm:text-5xl">Our team</h1>
				<p class="mt-4 max-w-2xl leading-relaxed text-[#B9C2B2]">
					City leaders representing JSBEE in their cities.
				</p>
				if provider.CityLeadEmail != "" {
					<p class="mt-3 max-w-2xl leading-relaxed text-[#B9C2B2]">
						Want to become a city leader? <a href={ templ.SafeURL("mailto:" + provider.CityLeadEmail) } class="font-medium text-[#C9A44A] hover:underline">Email us</a>
					</p>
				}
			</div>
		</header>
		<main class="mx-auto w-full max-w-3xl flex-1 px-4 py-10 sm:px-6">
			if len(leaders) == 0 {
				<p class="mt-8 text-center text-sm text-stone-500">No city leaders yet.</p>
			} else {
				<ul class="mt-8 border-t border-[#B9C2B2]">
					for _, leader := range leaders {
						<li class="border-b border-[#D3D8C6]">
							<a
								href={ templ.SafeURL("/author?uuid=" + leader.UUID.String()) }
								class="flex items-baseline justify-between gap-4 px-3 py-5 transition-all duration-200 hover:-translate-y-0.5 hover:bg-[#F5F6EF] hover:shadow-[0_4px_14px_-8px_rgba(22,33,27,0.4)]"
							>
								<span class="font-serif text-xl font-semibold text-stone-900">{ leader.Name }</span>
								if leader.CityLead != nil {
									<span class="shrink-0 text-sm font-medium text-[#33523B]">{ *leader.CityLead }</span>
								}
							</a>
						</li>
					}
				</ul>
			}
		</main>
		@siteFooter(provider.SiteName)
	</div>
}

templ TeamPage(leaders []database.User, firebaseClientConfig string) {
	@base(teamInfo, teamPage(leaders), firebaseClientConfig)
}
