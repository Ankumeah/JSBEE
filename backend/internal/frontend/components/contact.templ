package components

import (
	"github.com/Ankumeah/JSBEE/backend/internal/provider"
)

var contactInfo = pageInfo{
	title:       "Contact us",
	description: "Contact JSBEE",
}

templ contactPage() {
	<div class="flex min-h-screen flex-col">
		@navBar(provider.SiteName, "")
		<header class="jsbee-band bg-[#16211B]">
			<div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-14">
				<p class="font-serif text-lg italic text-[#C9A44A]">Get in touch</p>
				<h1 class="mt-3 font-serif text-4xl font-semibold text-[#F2F3EA] sm:text-5xl">Contact us</h1>
			</div>
		</header>
		<main class="mx-auto w-full max-w-3xl flex-1 px-4 py-10 sm:px-6">
			<ul class="mt-8 space-y-4 border-y border-[#B9C2B2] py-6 text-sm">
				<li class="flex items-center justify-between gap-4 border-b border-stone-100 pb-3">
					<span class="font-medium text-stone-500">Email</span>
					<a href={ templ.SafeURL("mailto:" + provider.SupportEmail) } class="font-medium text-[#33523B] hover:underline">{ provider.SupportEmail }</a>
				</li>
				<li class="flex items-center justify-between gap-4 border-b border-stone-100 pb-3">
					<span class="font-medium text-stone-500">Instagram</span>
					<a href={ templ.SafeURL(provider.InstagramLink) } target="_blank" rel="noopener" class="font-medium text-[#33523B] hover:underline">Instagram</a>
				</li>
				<li class="flex items-center justify-between gap-4 border-b border-stone-100 pb-3">
					<span class="font-medium text-stone-500">X</span>
					<a href={ templ.SafeURL(provider.XLink) } target="_blank" rel="noopener" class="font-medium text-[#33523B] hover:underline">X</a>
				</li>
				<li class="flex items-center justify-between gap-4">
					<span class="font-medium text-stone-500">LinkedIn</span>
					<a href={ templ.SafeURL(provider.LinkedInLink) } target="_blank" rel="noopener" class="font-medium text-[#33523B] hover:underline">LinkedIn</a>
				</li>
			</ul>
		</main>
		@siteFooter(provider.SiteName)
	</div>
}

templ ContactPage(firebaseClientConfig map[string]any) {
	@base(contactInfo, contactPage(), firebaseClientConfig)
}
