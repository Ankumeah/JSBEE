package components

import (
	"github.com/Ankumeah/JSBEE/backend/internal/provider"
	"github.com/Ankumeah/JSBEE/backend/internal/frontend/assets"
)

var notFoundInfo = pageInfo{
	title:       "Page not found",
	description: "This page does not exist",
}

templ notFoundPage() {
	<div class="flex min-h-screen flex-col">
		@navBar(provider.SiteName, "")
		<main class="mx-auto flex w-full max-w-5xl flex-1 flex-col items-center justify-center px-4 py-16 sm:px-6">
			<h1 class="font-serif text-3xl font-semibold text-stone-900 sm:text-4xl">Page not found</h1>
			<img
				src={ "/" + assets.NotFoundImage }
				alt=""
				class="mt-10 w-full max-w-md"
			/>
			<p class="mt-6 text-center text-sm text-stone-500">
				Art by: { "<Some random guy who shall not be named>" }
			</p>
			<a
				href="/"
				class="mt-10 text-sm font-medium text-emerald-800 hover:underline"
			>
				Back to home
			</a>
		</main>
		@siteFooter(provider.SiteName)
	</div>
}

templ NotFoundPage(firebaseClientConfig string) {
	@base(notFoundInfo, notFoundPage(), firebaseClientConfig)
}
