package components

templ popUp(message string) {
	<div
		id="toast"
		class="pointer-events-none fixed inset-x-0 top-4 z-[60] flex justify-center px-4"
	>
		<div
			id="toast-body"
			class="pointer-events-none flex w-full max-w-[70%] flex-col gap-3 rounded-lg bg-emerald-900 px-5 py-4 text-sm font-medium text-white shadow-lg opacity-0 -translate-y-2 transition-all duration-300"
			role="status"
		>
			<div class="flex items-center gap-4">
				<span id="toast-msg" class="flex-1">{ message }</span>
				<button
					type="button"
					class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md text-2xl leading-none text-white/70 transition-colors hover:bg-white/10 hover:text-white"
					onclick="hideToast()"
					aria-label="Dismiss"
				>
					&times;
				</button>
			</div>
			<div id="toast-actions" class="flex justify-end gap-2"></div>
		</div>
	</div>
	<span class="hidden pointer-events-auto pointer-events-none opacity-100 translate-y-0 bg-red-600 hover:bg-red-700 bg-white/10 hover:bg-white/20 bg-emerald-600 hover:bg-emerald-700 bg-stone-500 hover:bg-stone-600"></span>
}
