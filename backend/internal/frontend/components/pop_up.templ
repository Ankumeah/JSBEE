package components

templ popUp(message string) {
	<div
		id="toast"
		class="pointer-events-none fixed inset-x-0 top-4 z-[60] flex justify-center px-4"
	>
		<div
			id="toast-body"
			class="pointer-events-auto flex items-center gap-4 rounded-lg bg-emerald-900 px-5 py-3 text-sm font-medium text-white shadow-lg opacity-0 -translate-y-2 transition-all duration-300"
			role="status"
		>
			<span id="toast-msg">{ message }</span>
			<button
				type="button"
				class="text-white/70 transition-colors hover:text-white"
				onclick="showToast(null)"
				aria-label="Dismiss"
			>
				&times;
			</button>
		</div>
	</div>
}
