package components

templ siteFooter(siteName string) {
	<footer class="mt-16 border-t border-stone-200 bg-white/40">
		<div class="mx-auto flex max-w-5xl flex-col gap-2 px-4 py-8 text-sm text-stone-500 sm:flex-row sm:items-center sm:justify-between sm:px-6">
			<p class="font-serif text-stone-800">{ siteName }</p>
			<p>Open access journal for sustainable business research.</p>
		</div>
	</footer>
}
