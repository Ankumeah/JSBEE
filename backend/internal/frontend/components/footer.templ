package components

templ siteFooter(siteName string) {
	<footer class="jsbee-band mt-20 bg-[#16211B]">
		<div class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
			<p class="font-serif text-5xl font-semibold text-[#F2F3EA]">{ siteName }</p>
			<p class="mt-3 max-w-md font-serif text-lg italic leading-relaxed text-[#B9C2B2]">A student-led platform for the next generation of thinkers.</p>
			<div class="mt-8 flex flex-wrap gap-x-8 gap-y-3 border-t border-white/15 pt-6 text-sm font-medium">
				<a href="/" class="text-[#EDEFE4] transition-colors hover:text-white hover:underline hover:underline-offset-4">Home</a>
				<a href="/volumes" class="text-[#EDEFE4] transition-colors hover:text-white hover:underline hover:underline-offset-4">Volumes</a>
				<a href="/blog" class="text-[#EDEFE4] transition-colors hover:text-white hover:underline hover:underline-offset-4">Blog</a>
				<a href="/about" class="text-[#EDEFE4] transition-colors hover:text-white hover:underline hover:underline-offset-4">About us</a>
				<a href="/team" class="text-[#EDEFE4] transition-colors hover:text-white hover:underline hover:underline-offset-4">Our team</a>
				<a href="/contact" class="text-[#EDEFE4] transition-colors hover:text-white hover:underline hover:underline-offset-4">Contact us</a>
			</div>
			<p class="mt-8 border-t border-white/15 pt-6 text-xs leading-relaxed text-[#8E9787]">Free to read. Reviewed by student editors before publication.</p>
		</div>
	</footer>
}
