package components

import (
	"github.com/Ankumeah/JSBEE/backend/internal/provider"
)

var aboutInfo = pageInfo{
	title:       "About us",
	description: "About us",
}

templ aboutPage(aboutURL string) {
	<div class="flex min-h-screen flex-col">
		@navBar(provider.SiteName, "")
		<header class="jsbee-band bg-[#16211B]">
			<div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-14">
				<p class="font-serif text-lg italic text-[#C9A44A]">Who we are</p>
				<h1 class="mt-3 font-serif text-4xl font-semibold text-[#F2F3EA] sm:text-5xl">About us</h1>
			</div>
		</header>
		<main class="mx-auto w-full max-w-3xl flex-1 px-4 py-10 sm:px-6">
			<div id="about-loading" class="mt-8 text-center text-sm text-stone-500">Loading...</div>
			<div id="about-error" class="mt-8 hidden text-center text-sm text-red-600"></div>
			<article id="about-content" class="blog-content mt-8 hidden"></article>
		</main>
		@siteFooter(provider.SiteName)
		<script>
			var aboutFetchURL = {{ aboutURL }};
			(function() {
				function initAbout() {
					var loading = document.getElementById('about-loading');
					var errorEl = document.getElementById('about-error');
					var contentEl = document.getElementById('about-content');
					fetch(aboutFetchURL)
						.then(function(resp) {
							return checkApiResponse(resp, 'Failed to load about page');
						}).then(function(resp) {
							return resp.text();
						}).then(function(md) {
							if (typeof marked === 'undefined' || typeof DOMPurify === 'undefined') {
								throw new Error('Markdown renderer failed to load');
							}
							if (!md || !md.trim()) {
								throw new Error('About us information is not available yet');
							}
							contentEl.innerHTML = DOMPurify.sanitize(marked.parse(md || ''));
							loading.classList.add('hidden');
							contentEl.classList.remove('hidden');
						}).catch(function(err) {
							loading.classList.add('hidden');
							errorEl.textContent = err.message;
							errorEl.classList.remove('hidden');
						});
				}
				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', initAbout);
				} else {
					initAbout();
				}
			})();
		</script>
	</div>
}

templ AboutPage(firebaseClientConfig, aboutURL string) {
	@base(aboutInfo, aboutPage(aboutURL), firebaseClientConfig)
}
