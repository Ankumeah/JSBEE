package components

import (
	"github.com/Ankumeah/JSBEE/backend/internal/provider"
)

var volumesInfo = pageInfo{
	title:       "Volumes",
	description: "View all volumes",
}

templ volumesPage() {
	<div class="flex min-h-screen flex-col">
		@navBar(provider.SiteName, "volumes")
		<header class="jsbee-band bg-[#16211B]">
			<div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
				<p class="font-serif text-lg italic text-[#B9C2B2]">The library</p>
				<h1 class="mt-3 font-serif text-4xl font-semibold text-[#F2F3EA] sm:text-5xl">Volumes</h1>
				<p class="mt-4 max-w-2xl leading-relaxed text-[#B9C2B2]">
					Published papers grouped by volume and issue.
				</p>
				<div id="browse" class="mt-7 max-w-md scroll-mt-24">
					<label for="volumes-filter" class="block text-sm font-medium text-[#EDEFE4]">
						Search research
					</label>
					<input
						id="volumes-filter"
						type="search"
						placeholder="Filter by title, author, category or location"
						class="mt-1.5 w-full rounded-[3px] border border-[#F2F3EA]/20 bg-[#0E1511] px-4 py-2.5 text-sm text-[#F2F3EA] placeholder:text-[#6E7768] outline-none transition-all focus:border-[#F2F3EA]/60"
					/>
					<div class="mt-3 flex flex-col gap-3 sm:flex-row">
						<label class="flex-1">
							<span class="sr-only">Filter by category</span>
							<select
								id="volumes-category"
								class="w-full rounded-[3px] border border-[#F2F3EA]/20 bg-[#0E1511] px-3 py-2 text-sm text-[#F2F3EA] outline-none transition-all focus:border-[#F2F3EA]/60"
							>
								<option value="">All categories</option>
							</select>
						</label>
						<label class="flex-1">
							<span class="sr-only">Filter by location</span>
							<select
								id="volumes-location"
								class="w-full rounded-[3px] border border-[#F2F3EA]/20 bg-[#0E1511] px-3 py-2 text-sm text-[#F2F3EA] outline-none transition-all focus:border-[#F2F3EA]/60"
							>
								<option value="">All locations</option>
							</select>
						</label>
					</div>
				</div>
			</div>
		</header>
		<main class="mx-auto w-full max-w-5xl flex-1 px-4 py-10 sm:px-6">
			<p id="volumes-count" class="hidden text-sm text-stone-500"></p>
			<div id="volumes-loading" class="mt-10 text-stone-500">Loading volumes...</div>
			<div id="volumes-error" class="mt-10 hidden text-sm text-[#7F1D1D]"></div>
			<p id="volumes-empty" class="mt-10 hidden text-stone-500">No volumes have been published yet.</p>
			<p id="volumes-no-match" class="mt-10 hidden text-stone-500">No papers match your filter.</p>
			<div id="volumes-list" class="mt-4 hidden border-t border-[#DDD5C2]"></div>
		</main>
		@siteFooter(provider.SiteName)
		<script>
			(function() {
				var uuidPattern = /^[0-9a-fA-F-]{36}$/;
				var totalPapers = 0;

				function safePaperUUID(uuid) {
					return typeof uuid === 'string' && uuidPattern.test(uuid) ? uuid : null;
				}

				function el(tag, className, text) {
					var node = document.createElement(tag);
					if (className) {
						node.className = className;
					}
					if (text != null) {
						node.textContent = text;
					}
					return node;
				}

				function paperItem(paper, volumeNumber, issueNumber) {
					var li = el('li', 'border-b border-[#E7E0CF] last:border-0');
					li.setAttribute('data-title', (paper.title || '').toLowerCase());
					li.setAttribute('data-author', '');
					li.setAttribute('data-location', (paper.location || '').toLowerCase());
					li.setAttribute('data-category', (paper.category || '').toLowerCase());
					li.setAttribute('data-location-display', paper.location || '');
					li.setAttribute('data-category-display', paper.category || '');
					var wrap = el('div', 'jsbee-row-hover px-3 py-4');
					var row = el('div', 'flex items-baseline gap-2');
					var link = el('a', 'min-w-0 font-serif text-lg font-medium text-stone-900 hover:underline hover:decoration-[#33523B] hover:underline-offset-4');
					var uuid = safePaperUUID(paper.uuid);
					if (uuid) {
						link.href = '/paper?uuid=' + encodeURIComponent(uuid);
					} else {
						link.setAttribute('aria-disabled', 'true');
					}
					link.textContent = paper.title || 'Untitled';
					row.appendChild(link);
					row.appendChild(el('span', 'jsbee-leader', null));
					var ownerUUID = safePaperUUID(paper.owner_uuid);
					if (ownerUUID) {
						var by = el('span', 'flex shrink-0 items-baseline gap-1 text-sm text-stone-500');
						by.appendChild(el('span', null, 'By'));
						var authorLink = el('a', 'jsbee-author-link font-medium text-[#33523B] hover:underline hover:underline-offset-4', '…');
						authorLink.href = '/author?uuid=' + encodeURIComponent(ownerUUID);
						authorLink.setAttribute('data-owner', ownerUUID);
						by.appendChild(authorLink);
						row.appendChild(by);
					}
					wrap.appendChild(row);
					var meta = [];
					if (paper.number != null) {
						meta.push('Paper № ' + paper.number);
					}
					meta.push('Volume ' + volumeNumber + ', Issue ' + issueNumber);
					if (paper.category) {
						meta.push(paper.category);
					}
					if (paper.location) {
						meta.push(paper.location);
					}
					wrap.appendChild(el('p', 'mt-1 text-xs text-stone-500', meta.join(', ')));
					li.appendChild(wrap);
					return li;
				}

				function issueBlock(issue, volumeNumber) {
					var block = el('div', 'mt-5 border-t border-[#E7E0CF] pt-4');
					block.setAttribute('data-issue', '');
					block.appendChild(el('h3', 'font-serif text-lg text-[#33523B]', 'Issue ' + issue.number));
					var papers = Array.isArray(issue.papers) ? issue.papers : [];
					if (!papers.length) {
						block.appendChild(el('p', 'mt-2 text-sm text-stone-500', 'No papers in this issue.'));
					} else {
						var ul = el('ul', 'mt-1');
						papers.forEach(function(paper) {
							ul.appendChild(paperItem(paper, volumeNumber, issue.number));
						});
						block.appendChild(ul);
					}
					return block;
				}

				function volumeBlock(volume) {
					var section = el('section', 'border-b border-[#DDD5C2] py-8');
					section.setAttribute('data-volume', '');
					var toggle = el('button', 'flex w-full items-center justify-between gap-4 text-left');
					toggle.type = 'button';
					toggle.setAttribute('aria-expanded', 'true');
					toggle.appendChild(el('h2', 'font-serif text-2xl font-semibold text-stone-900', 'Volume ' + volume.number));
					var label = el('span', 'text-sm text-stone-500', 'Hide');
					toggle.appendChild(label);
					var body = el('div');
					var issues = Array.isArray(volume.issues) ? volume.issues : [];
					if (!issues.length) {
						body.appendChild(el('p', 'mt-4 text-sm text-stone-500', 'No issues in this volume.'));
					} else {
						issues.forEach(function(issue) {
							body.appendChild(issueBlock(issue, volume.number));
						});
					}
					toggle.addEventListener('click', function() {
						var open = body.classList.toggle('hidden');
						label.textContent = open ? 'Show' : 'Hide';
						toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
					});
					section.appendChild(toggle);
					section.appendChild(body);
					return section;
				}

				function loadAuthorNames() {
					var links = document.querySelectorAll('.jsbee-author-link[data-owner]');
					if (!links.length) {
						applyFilter();
						return;
					}
					var seen = {};
					var pending = 0;
					Array.prototype.forEach.call(links, function(link) {
						var uuid = link.getAttribute('data-owner');
						if (!uuid || seen[uuid]) {
							return;
						}
						seen[uuid] = true;
						pending += 1;
						fetch('/api/v1/user?uuid=' + encodeURIComponent(uuid))
							.then(function(resp) {
								return checkApiResponse(resp, 'Failed to load author');
							}).then(function(resp) {
								return resp.json();
							}).then(function(data) {
								if (!data || !data.user || !data.user.name) {
									return;
								}
								Array.prototype.forEach.call(
									document.querySelectorAll('.jsbee-author-link[data-owner="' + uuid + '"]'),
									function(node) {
										node.textContent = data.user.name;
										var li = node.closest('li[data-author]');
										if (li) {
											li.setAttribute('data-author', data.user.name.toLowerCase());
										}
									}
								);
							}).catch(function() {}).finally(function() {
								pending -= 1;
								if (pending === 0) {
									applyFilter();
								}
							});
					});
					if (pending === 0) {
						applyFilter();
					}
				}

				function applyFilter() {
					var q = document.getElementById('volumes-filter').value.toLowerCase().trim();
					var category = document.getElementById('volumes-category').value.toLowerCase();
					var location = document.getElementById('volumes-location').value.toLowerCase();
					var filtered = q !== '' || category !== '' || location !== '';
					var visible = 0;
					Array.prototype.forEach.call(
						document.querySelectorAll('#volumes-list [data-volume]'),
						function(section) {
							var sectionVisible = false;
							Array.prototype.forEach.call(
								section.querySelectorAll('[data-issue]'),
								function(block) {
									var issueVisible = false;
									Array.prototype.forEach.call(
										block.querySelectorAll('li[data-title]'),
										function(li) {
											var title = li.getAttribute('data-title') || '';
											var author = li.getAttribute('data-author') || '';
											var loc = li.getAttribute('data-location') || '';
											var cat = li.getAttribute('data-category') || '';
											var matchText = q === '' ||
												title.indexOf(q) !== -1 ||
												author.indexOf(q) !== -1 ||
												loc.indexOf(q) !== -1 ||
												cat.indexOf(q) !== -1;
											var matchCategory = category === '' || cat === category;
											var matchLocation = location === '' || loc === location;
											var match = matchText && matchCategory && matchLocation;
											li.classList.toggle('hidden', !match);
											issueVisible = issueVisible || match;
											if (match) {
												visible += 1;
											}
										}
									);
									block.classList.toggle('hidden', !issueVisible);
									sectionVisible = sectionVisible || issueVisible;
								}
							);
							section.classList.toggle('hidden', !sectionVisible);
						}
					);
					var countEl = document.getElementById('volumes-count');
					if (!filtered) {
						countEl.textContent = totalPapers === 1 ? '1 paper' : totalPapers + ' papers';
					} else {
						countEl.textContent = visible === 1 ? '1 matching paper' : visible + ' matching papers';
					}
					document.getElementById('volumes-no-match').classList.toggle('hidden', visible > 0 || !filtered);
				}

				// Dropdown options come from the data itself so they can
				// never drift from what is actually published. Papers from
				// before location/category existed carry empty values and
				// are left out of the options.
				function buildFilters() {
					var categories = {};
					var locations = {};
					Array.prototype.forEach.call(
						document.querySelectorAll('#volumes-list li[data-title]'),
						function(li) {
							var cat = li.getAttribute('data-category') || '';
							var loc = li.getAttribute('data-location') || '';
							if (cat && !categories[cat]) {
								categories[cat] = li.getAttribute('data-category-display') || cat;
							}
							if (loc && !locations[loc]) {
								locations[loc] = li.getAttribute('data-location-display') || loc;
							}
						}
					);
					function fill(id, values) {
						var select = document.getElementById(id);
						Object.keys(values).sort(function(a, b) {
							return values[a].toLowerCase().localeCompare(values[b].toLowerCase());
						}).forEach(function(value) {
							var option = document.createElement('option');
							option.value = value;
							option.textContent = values[value];
							select.appendChild(option);
						});
					}
					fill('volumes-category', categories);
					fill('volumes-location', locations);
				}

				function initVolumes() {
					var loading = document.getElementById('volumes-loading');
					var errorEl = document.getElementById('volumes-error');
					var emptyEl = document.getElementById('volumes-empty');
					var list = document.getElementById('volumes-list');

					document.getElementById('volumes-filter').addEventListener('input', applyFilter);
					document.getElementById('volumes-category').addEventListener('change', applyFilter);
					document.getElementById('volumes-location').addEventListener('change', applyFilter);

					fetch('/api/v1/paper/volumes')
						.then(function(resp) {
							return checkApiResponse(resp, 'Failed to load volumes');
						})
						.then(function(resp) {
							return resp.json();
						})
						.then(function(data) {
							var volumes = (data && Array.isArray(data.volumes)) ? data.volumes : [];
							loading.classList.add('hidden');
							if (!volumes.length) {
								emptyEl.classList.remove('hidden');
								return;
							}
							volumes.forEach(function(volume) {
								list.appendChild(volumeBlock(volume));
							});
							totalPapers = list.querySelectorAll('li[data-title]').length;
							document.getElementById('volumes-count').classList.remove('hidden');
							list.classList.remove('hidden');
							buildFilters();
							loadAuthorNames();
						})
						.catch(function(err) {
							loading.classList.add('hidden');
							errorEl.textContent = 'Failed to load volumes: ' + err.message;
							errorEl.classList.remove('hidden');
						});
				}
				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', initVolumes);
				} else {
					initVolumes();
				}
			})();
		</script>
	</div>
}

templ VolumesPage(firebaseClientConfig map[string]any) {
	@base(volumesInfo, volumesPage(), firebaseClientConfig)
}
