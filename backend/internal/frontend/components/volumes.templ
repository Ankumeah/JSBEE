package components

import (
	"fmt"
	"strconv"
	"strings"

	"github.com/Ankumeah/JSBEE/backend/internal/database"
	"github.com/Ankumeah/JSBEE/backend/internal/provider"
)

var volumesInfo = pageInfo{
	title:       "Volumes",
	description: "View all volumes",
}

templ paperItem(paper database.Paper, filesBaseURL string) {
	<li
		class="border-b border-stone-100 last:border-0"
		data-title={ strings.ToLower(paper.Title) }
		x-show="q === '' || $el.dataset.title.includes(q.toLowerCase())"
	>
		<div class="flex items-baseline gap-2">
			<a
				href={ templ.SafeURL("/paper?uuid=" + paper.UUID.String()) }
				class="flex min-w-0 flex-1 flex-col gap-1 rounded-[3px] px-3 py-3 transition-all duration-200 hover:-translate-y-0.5 hover:bg-[#F5F6EF] hover:shadow-[0_4px_14px_-8px_rgba(22,33,27,0.4)] sm:flex-row sm:items-baseline sm:gap-3"
			>
				if paper.Number != nil {
					<span class="shrink-0 font-mono text-xs text-[#9A7B2D]">#{ strconv.FormatUint(*paper.Number, 10) }</span>
				}
				<span class="font-medium text-stone-900">{ paper.Title }</span>
			</a>
			if paper.OwnerUUID != nil {
				<span class="flex shrink-0 items-baseline gap-1.5 py-3 pr-1 text-sm text-stone-400">
					<span aria-hidden="true">-</span>
					<a
						href={ templ.SafeURL("/author?uuid=" + paper.OwnerUUID.String()) }
						data-owner={ paper.OwnerUUID.String() }
						class="jsbee-author-link transition-colors hover:text-[#33523B] hover:underline"
					>
						—
					</a>
				</span>
			}
		</div>
	</li>
}

templ issueBlock(issue database.Issue, filesBaseURL string) {
	<div class="mt-5 border-t border-[#D3D8C6] pt-4">
		<h3 class="font-serif text-lg text-[#33523B]">
			Issue { fmt.Sprintf("%d", issue.Number) }
		</h3>
		if len(issue.Papers) == 0 {
			<p class="mt-2 text-sm text-stone-500">No papers in this issue.</p>
		} else {
			<ul class="mt-1">
				for _, paper := range issue.Papers {
					@paperItem(paper, filesBaseURL)
				}
			</ul>
		}
	</div>
}

templ volumeBlock(volume database.Volume, filesBaseURL string) {
	<section
		class="border-b border-[#B9C2B2] py-8"
		x-data="{ open: true }"
	>
		<button
			type="button"
			class="flex w-full items-center justify-between gap-4 text-left"
			@click="open = !open"
			:aria-expanded="open.toString()"
		>
			<h2 class="font-serif text-2xl font-semibold text-stone-900">
				Volume { fmt.Sprintf("%d", volume.Number) }
			</h2>
			<span class="text-sm text-stone-500" x-text="open ? 'Hide' : 'Show'"></span>
		</button>
		<div x-show="open" x-cloak>
			if len(volume.Issues) == 0 {
				<p class="mt-4 text-sm text-stone-500">No issues in this volume.</p>
			} else {
				for _, issue := range volume.Issues {
					@issueBlock(issue, filesBaseURL)
				}
			}
		</div>
	</section>
}

templ volumesPage(volumes []database.Volume, filesBaseURL string) {
	<div class="flex min-h-screen flex-col" x-data="{ q: '' }">
		@navBar(provider.SiteName, "volumes")
		<header class="jsbee-band bg-[#16211B]">
			<div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
				<p class="font-serif text-lg italic text-[#C9A44A]">The library</p>
				<h1 class="mt-3 font-serif text-4xl font-semibold text-[#F2F3EA] sm:text-5xl">Volumes</h1>
				<p class="mt-4 max-w-2xl leading-relaxed text-[#B9C2B2]">
					Published papers grouped by volume and issue.
				</p>
				<label class="mt-7 block max-w-md">
					<span class="sr-only">Filter papers</span>
					<input
						type="search"
						placeholder="Filter by title"
						class="w-full rounded-[3px] border border-[#F2F3EA]/20 bg-[#0E1511] px-4 py-2.5 text-sm text-[#F2F3EA] placeholder:text-[#6E7768] outline-none transition-all focus:border-[#C9A44A] focus:ring-2 focus:ring-[#C9A44A]/30"
						x-model="q"
					/>
				</label>
			</div>
		</header>
		<main class="mx-auto w-full max-w-5xl flex-1 px-4 py-10 sm:px-6">
			if len(volumes) == 0 {
				<p class="mt-10 text-stone-500">No volumes have been published yet.</p>
			} else {
				<div class="mt-4 border-t border-[#B9C2B2]">
					for _, volume := range volumes {
						@volumeBlock(volume, filesBaseURL)
					}
				</div>
			}
		</main>
		@siteFooter(provider.SiteName)
		<script>
			(function() {
				function initVolumeAuthors() {
					var links = document.querySelectorAll('.jsbee-author-link[data-owner]');
					if (!links.length) {
						return;
					}
					var seen = {};
					Array.prototype.forEach.call(links, function(link) {
						var uuid = link.getAttribute('data-owner');
						if (!uuid || seen[uuid]) {
							return;
						}
						seen[uuid] = true;
						fetch('/api/v1/user?uuid=' + encodeURIComponent(uuid))
							.then(function(resp) {
								return checkApiResponse(resp, 'Failed to load author');
							}).then(function(resp) {
								return resp.json();
							}).then(function(data) {
								if (!data || !data.user || !data.user.name) {
									return;
								}
								Array.prototype.forEach.call(
									document.querySelectorAll('.jsbee-author-link[data-owner="' + uuid + '"]'),
									function(el) {
										el.textContent = data.user.name;
									}
								);
							}).catch(function() {});
					});
				}
				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', initVolumeAuthors);
				} else {
					initVolumeAuthors();
				}
			})();
		</script>
	</div>
}

templ VolumesPage(volumes []database.Volume, firebaseClientConfig map[string]any, filesBaseURL string) {
	@base(volumesInfo, volumesPage(volumes, filesBaseURL), firebaseClientConfig)
}
