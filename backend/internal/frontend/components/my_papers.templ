package components

templ myPapers() {
	<div class="mt-6 max-w-xl" x-data="{ open: false }">
		<button
			type="button"
			class="inline-flex w-full items-center justify-between rounded-lg border border-stone-300 bg-white/60 px-4 py-2.5 text-sm font-semibold text-stone-800 transition-colors hover:bg-stone-100"
			@click="open = !open"
			:aria-expanded="open.toString()"
			aria-controls="my-papers-panel"
		>
			My papers
			<svg
				class="h-4 w-4 text-stone-500 transition-transform"
				:class="open ? 'rotate-180' : ''"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
				aria-hidden="true"
			>
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
			</svg>
		</button>
		<div
			id="my-papers-panel"
			class="mt-2 rounded-lg border border-stone-200 bg-white/70 px-4 py-4 text-sm text-stone-600 shadow-sm"
			x-cloak
			x-show="open"
			x-transition
		>
			<span class="font-mono text-xs text-stone-400">{ "// TODO: Get papers" }</span>
		</div>
	</div>
}