package components

import (
	"github.com/Ankumeah/JSBEE/backend/internal/provider"
)

var profileInfo = pageInfo{
	title:       "Profile",
	description: "Your profile",
}

templ profilePage() {
	<div class="flex min-h-screen flex-col">
		@navBar(provider.SiteName, "profile")
		<main class="mx-auto w-full max-w-3xl flex-1 px-4 py-12 sm:px-6">
			<h1 class="text-center font-serif text-4xl font-semibold text-stone-900">My Profile</h1>
			<div id="profile-loading" class="mt-8 text-center text-sm text-stone-500">Loading your profile...</div>
			<div id="profile-error" class="mt-8 hidden text-center text-sm text-red-600"></div>
			<div
				id="profile-card"
				class="mt-8 rounded-xl border border-stone-200 bg-white/50 p-6 shadow-sm"
			>
				<dl class="space-y-4 text-sm">
					<div class="flex items-center justify-between gap-4 border-b border-stone-100 pb-3">
						<dt class="font-medium text-stone-500">Name</dt>
						<dd id="profile-name" class="text-stone-900"></dd>
					</div>
					<div class="flex items-center justify-between gap-4 border-b border-stone-100 pb-3">
						<dt class="font-medium text-stone-500">Email</dt>
						<dd id="profile-email" class="text-stone-900"></dd>
					</div>
					<div class="flex items-center justify-between gap-4 border-b border-stone-100 pb-3">
						<dt class="font-medium text-stone-500">Role</dt>
						<dd id="profile-role" class="text-stone-900"></dd>
					</div>
					<div class="flex items-center justify-between gap-4">
						<dt class="font-medium text-stone-500">Subscribed</dt>
						<dd class="flex items-center gap-3">
							<span id="profile-subscribed" class="text-stone-900"></span>
							<button
								id="profile-sub-toggle"
								type="button"
								class="hidden rounded-md px-3 py-1 text-xs font-semibold text-white transition-colors"
							></button>
						</dd>
					</div>
				</dl>
			</div>
			@myPapers()
			<button
				id="profile-logout"
				type="button"
				class="mt-8 hidden w-full rounded-lg bg-red-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-red-700"
			>
				Log out
			</button>
		</main>
		@siteFooter(provider.SiteName)
		<script>
			(function() {
				function initProfile() {
					var uuid = getFirebaseUuid();
					var loading = document.getElementById('profile-loading');
					var errorEl = document.getElementById('profile-error');
					var card = document.getElementById('profile-card');
					var logoutBtn = document.getElementById('profile-logout');
					var subBtn = document.getElementById('profile-sub-toggle');
					var subValue = document.getElementById('profile-subscribed');

					if (localStorage.getItem('jsbee_welcome')) {
						localStorage.removeItem('jsbee_welcome');
						showToast("Great you are logged in. By default we dont send you any emails, to get emails about your papers and our latest news, go to your profile and click on subscribe");
					}

					function renderSubscription(subscribed) {
						subValue.textContent = subscribed ? 'Yes' : 'No';
						subBtn.textContent = subscribed ? 'Unsubscribe' : 'Subscribe';
						subBtn.classList.remove('bg-emerald-600', 'hover:bg-emerald-700', 'bg-stone-500', 'hover:bg-stone-600');
						if (subscribed) {
							subBtn.classList.add('bg-stone-500', 'hover:bg-stone-600');
						} else {
							subBtn.classList.add('bg-emerald-600', 'hover:bg-emerald-700');
						}
						subBtn.classList.remove('hidden');
					}

					subBtn.addEventListener('click', function() {
						var token = getFirebaseJwt();
						if (!token) {
							showToast('Not signed in');
							return;
						}
						var subscribed = subValue.textContent === 'Yes';
						subBtn.disabled = true;
						fetch('/api/v1/account?sub=' + !subscribed, {
							method: 'PATCH',
							headers: { 'Authorization': 'Bearer ' + token }
						}).then(function(resp) {
							if (!resp.ok) {
								throw new Error('Failed to update subscription');
							}
							renderSubscription(!subscribed);
							showToast(!subscribed ? 'You are now subscribed' : 'You are now unsubscribed');
						}).catch(function(err) {
							showToast('Subscription update failed: ' + err.message);
						}).finally(function() {
							subBtn.disabled = false;
						});
					});

logoutBtn.addEventListener('click', function() {
					showToastWithActions('Are you sure you want to log out?', [
						{
							label: 'Cancel',
							pressed: function() {
								hideToast();
							}
						},
						{
							label: 'Log out',
							danger: true,
							pressed: function() {
								hideToast();
								firebaseSignOut().then(function() {
									window.location.href = '/';
								}).catch(function() {
									window.location.href = '/';
								});
							}
						}
					]);
				});

					if (!uuid) {
						loading.textContent = 'Please sign in to view your profile.';
						document.getElementById('my-papers-box').classList.add('hidden');
						return;
					}
					fetch('/api/v1/user?uuid=' + encodeURIComponent(uuid))
						.then(function(resp) {
							if (!resp.ok) {
								throw new Error('Failed to load profile');
							}
							return resp.json();
						})
						.then(function(data) {
							var user = data.user;
							document.getElementById('profile-name').textContent = user.name;
							document.getElementById('profile-email').textContent = user.email;
							document.getElementById('profile-role').textContent = user.role ? user.role.role : 'Unknown';
							renderSubscription(user.subscribed);
							loading.classList.add('hidden');
							errorEl.classList.add('hidden');
							card.classList.remove('hidden');
							logoutBtn.classList.remove('hidden');

							var jwt = getFirebaseJwt();
							var papersBox = document.getElementById('my-papers-box');
							if (jwt) {
								papersBox.classList.remove('hidden');
								fetch('/api/v1/papers', {
									headers: { 'Authorization': 'Bearer ' + jwt }
								}).then(function(resp) {
									if (!resp.ok) throw new Error('Failed to load papers');
									return resp.json();
								}).then(function(data) {
									var papers = data.papers || [];
									var loadingEl = document.getElementById('my-papers-loading');
									var emptyEl = document.getElementById('my-papers-empty');
									var listEl = document.getElementById('my-papers-list');
									loadingEl.classList.add('hidden');
									if (papers.length === 0) {
										emptyEl.classList.remove('hidden');
										return;
									}
									papers.forEach(function(paper) {
										var li = document.createElement('li');
										var a = document.createElement('a');
										a.href = '/paper?uuid=' + encodeURIComponent(paper.uuid);
										a.className = 'flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6 rounded hover:bg-stone-100/50';
										var left = document.createElement('div');
										if (paper.number != null) {
											var num = document.createElement('span');
											num.className = 'mr-2 font-mono text-xs text-amber-800';
											num.textContent = '#' + paper.number;
											left.appendChild(num);
										}
										var title = document.createElement('span');
										title.className = 'font-medium text-stone-900';
										title.textContent = paper.title;
										left.appendChild(title);
										a.appendChild(left);
										if (paper.filename) {
											var fname = document.createElement('span');
											fname.className = 'shrink-0 text-sm text-stone-500';
											fname.textContent = paper.filename;
											a.appendChild(fname);
										}
										li.appendChild(a);
										listEl.appendChild(li);
									});
									listEl.classList.remove('hidden');
								}).catch(function(err) {
									document.getElementById('my-papers-loading').classList.add('hidden');
									var errEl = document.getElementById('my-papers-error');
									errEl.textContent = err.message;
									errEl.classList.remove('hidden');
								});
							} else {
								papersBox.classList.add('hidden');
							}
						})
						.catch(function(err) {
							loading.classList.add('hidden');
							errorEl.textContent = 'Failed to load profile: ' + err.message;
							errorEl.classList.remove('hidden');
						});
				}
				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', initProfile);
				} else {
					initProfile();
				}
			})();
		</script>
	</div>
}

templ ProfilePage(firebaseClientConfig string) {
	@base(profileInfo, profilePage(), firebaseClientConfig)
}
