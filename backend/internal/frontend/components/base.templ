package components

templ base(info pageInfo, content templ.Component, firebaseClientConfig string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="description" content={ info.description }/>
			<title>{ info.title }</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
			<link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&display=swap" rel="stylesheet"/>
			<script src="https://cdn.tailwindcss.com"></script>
			<style>
				[x-cloak] { display: none !important; }
				body { font-family: "Source Sans 3", system-ui, sans-serif; }
				.font-serif { font-family: "Source Serif 4", Georgia, serif; }
			</style>
			<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js"></script>
			<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-auth-compat.js"></script>
			<script>
				const firebaseApp = firebase.initializeApp({{ jsObjectFromJSON(firebaseClientConfig) }});
				const firebaseAuth = firebase.auth();

				function firebaseSignIn() {
					if (firebaseAuth.currentUser) {
						return firebaseAuth.currentUser.getIdToken(true);
					}
					const provider = new firebase.auth.GoogleAuthProvider();
					return firebaseAuth.signInWithPopup(provider).then(function(result) {
						return result.user.getIdToken();
					});
				}

				function firebaseSignOut() {
					localStorage.removeItem('firebase_jwt');
					localStorage.removeItem('jsbee_uuid');
					_authReadyPromise = null;
					return firebaseAuth.signOut();
				}

				function firebaseRefreshToken() {
					if (!firebaseAuth.currentUser) {
						return Promise.reject(new Error('No user signed in'));
					}
					return firebaseAuth.currentUser.getIdToken(true);
				}

				function getFirebaseJwt() {
					return localStorage.getItem('firebase_jwt');
				}

				function setFirebaseJwt(token) {
					localStorage.setItem('firebase_jwt', token);
				}

				function getFirebaseUuid() {
					return localStorage.getItem('jsbee_uuid');
				}

				function setFirebaseUuid(uuid) {
					localStorage.setItem('jsbee_uuid', uuid);
				}

				function clearFirebaseSession() {
					localStorage.removeItem('firebase_jwt');
					localStorage.removeItem('jsbee_uuid');
				}

				function checkApiResponse(resp, fallback) {
					if (resp.ok) {
						return Promise.resolve(resp);
					}
					return resp.text().then(function(text) {
						var message = fallback || 'Request failed';
						try {
							var parsed = JSON.parse(text);
							if (parsed && parsed.error) {
								message = parsed.error;
							} else if (text) {
								message = text;
							}
						} catch (e) {
							if (text) {
								message = text;
							}
						}
						console.warn('API request failed:', resp.url, resp.status, text);
						var err = new Error(message);
						err.status = resp.status;
						throw err;
					});
				}

				function isSessionExpiredError(err) {
					return err && err.status === 401;
				}

				function handleSessionExpired() {
					clearFirebaseSession();
					showAuthFailedToast('Session expired, please sign in again');
				}

				function showAuthFailedToast(message) {
					showToastWithActions(message, [
						{
							label: 'Cancel',
							pressed: function() {
								hideToast();
							}
						},
						{
							label: 'Log out',
							danger: true,
							pressed: function() {
								hideToast();
								firebaseSignOut().then(function() {
									window.location.href = '/';
								}).catch(function() {
									window.location.href = '/';
								});
							}
						}
					]);
				}

				var _authReadyPromise = null;

				function waitForAuthUser() {
					if (firebaseAuth.currentUser) {
						return Promise.resolve(firebaseAuth.currentUser);
					}
					if (!_authReadyPromise) {
						_authReadyPromise = new Promise(function(resolve) {
							var unsub = firebaseAuth.onAuthStateChanged(function(user) {
								try {
									unsub();
								} catch (e) {}
								resolve(user || null);
							});
						});
					}
					return _authReadyPromise;
				}

				function reauthenticate() {
					_authReadyPromise = null;
					return firebaseAuth.signOut().catch(function() {}).then(function() {
						clearFirebaseSession();
						return firebaseSignIn();
					}).then(function(idToken) {
						setFirebaseJwt(idToken);
						return idToken;
					}, function(err) {
						if (err && (err.code === 'auth/popup-blocked' || err.code === 'auth/popup-closed-by-user' || err.code === 'auth/cancelled-popup-request')) {
							throw new Error('Please sign in again to continue');
						}
						throw err;
					});
				}

				function getValidToken() {
					return waitForAuthUser().then(function(user) {
						if (!user) {
							return null;
						}
						return user.getIdToken(false).then(function(token) {
							setFirebaseJwt(token);
							return token;
						}, function() {
							_authReadyPromise = null;
							return firebaseAuth.signOut().catch(function() {}).then(function() {
								clearFirebaseSession();
								return null;
							});
						});
					});
				}

				function authFetch(path, options) {
					options = options || {};
					function send(token) {
						var headers = {};
						if (options.headers) {
							for (var key in options.headers) {
								headers[key] = options.headers[key];
							}
						}
						headers['Authorization'] = 'Bearer ' + token;
						return fetch(path, {
							method: options.method || 'GET',
							headers: headers,
							body: options.body
						});
					}
					return getValidToken().then(function(token) {
						if (!token) {
							var err = new Error('Not signed in');
							err.status = 401;
							throw err;
						}
						return send(token).then(function(resp) {
							if (resp.status !== 401) {
								return resp;
							}
							return reauthenticate().then(send);
						});
					});
				}

				function ensureSignedIn() {
					return waitForAuthUser().then(function(user) {
						if (!user) {
							return firebaseSignIn();
						}
						return user.getIdToken().then(function(idToken) {
							return idToken;
						}, function() {
							return reauthenticate();
						});
					}).then(function(idToken) {
						return fetch('/api/v1/account', {
							method: 'POST',
							headers: { 'Authorization': 'Bearer ' + idToken }
						}).then(function(resp) {
							return checkApiResponse(resp, 'Backend registration failed');
						}).then(function(resp) {
							return resp.json();
						}).then(function(data) {
							if (!data || !data.uuid) {
								throw new Error('Backend registration failed: missing user id');
							}
							setFirebaseUuid(data.uuid);
							return firebaseRefreshToken();
						});
					}).then(function(refreshedToken) {
						setFirebaseJwt(refreshedToken);
						return refreshedToken;
					});
				}

				firebaseAuth.onIdTokenChanged(function(user) {
					if (user) {
						user.getIdToken().then(function(token) {
							setFirebaseJwt(token);
						}).catch(function() {});
					}
				});

				function hideToast() {
					var body = document.getElementById('toast-body');
					if (!body) {
						return;
					}
					body.classList.add('opacity-0', '-translate-y-2', 'pointer-events-none');
					body.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
				}

				function showToast(message) {
					var body = document.getElementById('toast-body');
					if (!body) {
						return;
					}
					document.getElementById('toast-msg').textContent = message;
					document.getElementById('toast-actions').innerHTML = '';
					body.classList.remove('opacity-0', '-translate-y-2', 'pointer-events-none');
					body.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
				}

				function showToastWithActions(message, actions) {
					var body = document.getElementById('toast-body');
					if (!body) {
						return;
					}
					document.getElementById('toast-msg').textContent = message;
					var actionsEl = document.getElementById('toast-actions');
					actionsEl.innerHTML = '';
					(actions || []).forEach(function(action) {
						var btn = document.createElement('button');
						btn.type = 'button';
						btn.textContent = action.label;
						btn.className = action.danger
							? 'rounded-md bg-red-600 px-3 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-red-700'
							: 'rounded-md bg-white/10 px-3 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-white/20';
						btn.addEventListener('click', function() {
							action.pressed();
						});
						actionsEl.appendChild(btn);
					});
					body.classList.remove('opacity-0', '-translate-y-2', 'pointer-events-none');
					body.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
				}
			</script>
		</head>
		<body class="min-h-screen bg-stone-50 font-sans text-stone-800 antialiased">
			@content
			@popUp("")
			<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>
		</body>
	</html>
}
