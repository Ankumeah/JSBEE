package components

import (
	"github.com/Ankumeah/JSBEE/backend/internal/provider"
)

var indexInfo = pageInfo{
	title:       provider.SiteName,
	description: provider.SiteDescription,
}

templ indexPage() {
	<div class="flex min-h-screen flex-col">
		@navBar(provider.SiteName, "home")
		<main class="mx-auto w-full max-w-5xl flex-1 px-4 py-12 sm:px-6">
			<section class="border-b border-stone-200 pb-12">
				<p class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-800">Academic journal</p>
				<h1 class="mt-3 font-serif text-4xl font-semibold leading-tight text-stone-900 sm:text-5xl">
					{ provider.SiteName }
				</h1>
				<p class="mt-4 max-w-2xl text-lg leading-relaxed text-stone-600">
					{ provider.SiteDescription }
				</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a
						href="/volumes"
						class="inline-flex items-center rounded-md bg-emerald-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-emerald-800"
					>
						Browse volumes
					</a>
				</div>
			</section>
			<section class="mt-12 grid gap-10 md:grid-cols-2">
				<div>
					<h2 class="font-serif text-2xl font-semibold text-stone-900">Aims and scope</h2>
					<p class="mt-3 leading-relaxed text-stone-600">
						JSBEE publishes research on sustainable enterprise in emerging economies:
						strategy, policy, finance, and practice that support long-term social and
						environmental value.
					</p>
				</div>
				<div>
					<h2 class="font-serif text-2xl font-semibold text-stone-900">For readers</h2>
					<p class="mt-3 leading-relaxed text-stone-600">
						Approved papers are organised by volume and issue. Open a volume to read
						titles and download published files as they become available.
					</p>
				</div>
			</section>
		</main>
		@siteFooter(provider.SiteName)
	</div>
}

templ IndexPage() {
	@base(indexInfo, indexPage())
}
