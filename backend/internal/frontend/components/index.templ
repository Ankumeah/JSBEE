package components

import (
	"github.com/Ankumeah/JSBEE/backend/internal/provider"
)

var indexInfo = pageInfo{
	title:       provider.SiteName,
	description: provider.SiteDescription,
}

templ indexPage() {
	<div class="flex min-h-screen flex-col">
		@navBar(provider.SiteName, "home")
		<main class="mx-auto w-full max-w-5xl flex-1 px-4 py-12 sm:px-6">
			<section class="border-b border-stone-200 pb-12">
				<p class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-800">Academic journal</p>
				<h1 class="mt-3 font-serif text-4xl font-semibold leading-tight text-stone-900 sm:text-5xl">
					{ provider.SiteName }
				</h1>
				<p class="mt-4 max-w-2xl text-lg leading-relaxed text-stone-600">
					{ provider.SiteDescription }
				</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a
						href="/volumes"
						class="inline-flex items-center rounded-md bg-emerald-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-emerald-800"
					>
						Browse volumes
					</a>
				</div>
			</section>
			<section class="mt-12 grid gap-10 md:grid-cols-2">
				<div>
					<h2 class="font-serif text-2xl font-semibold text-stone-900">Aims and scope</h2>
					<p class="mt-3 leading-relaxed text-stone-600">
						JSBEE publishes research on sustainable enterprise in emerging economies:
						strategy, policy, finance, and practice that support long-term social and
						environmental value.
					</p>
				</div>
				<div>
					<h2 class="font-serif text-2xl font-semibold text-stone-900">For readers</h2>
					<p class="mt-3 leading-relaxed text-stone-600">
						Approved papers are organised by volume and issue. Open a volume to read
						titles and download published files as they become available.
					</p>
				</div>
			</section>
			<section class="mt-16 rounded-xl border border-emerald-900/20 bg-white/50 p-8 shadow-sm">
				<h2 class="font-serif text-2xl font-semibold text-stone-900">Publish your own paper!</h2>
				<p class="mt-3 leading-relaxed text-stone-600">
					Have research to share? Upload your PDF below. It will be reviewed by our
					editors before being published in an upcoming volume.
				</p>
				<button
					id="publish-start"
					type="button"
					class="mt-6 inline-flex items-center rounded-md bg-emerald-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-emerald-800"
				>
					Start publishing
				</button>
				<div
					id="publish-form"
					class="mt-6 hidden"
				>
					<form id="publish-upload" enctype="multipart/form-data" class="space-y-4">
						<div>
							<label
								for="publish-title"
								class="block text-sm font-medium text-stone-700"
							>
								Paper title
							</label>
							<input
								id="publish-title"
								type="text"
								name="title"
								required
								class="mt-1 w-full rounded-md border border-stone-300 bg-white px-3 py-2 text-sm text-stone-900 focus:border-emerald-700 focus:outline-none"
							/>
						</div>
						<div>
							<label
								for="publish-file"
								class="block text-sm font-medium text-stone-700"
							>
								PDF file
							</label>
							<input
								id="publish-file"
								type="file"
								name="file"
								accept="application/pdf"
								required
								class="mt-1 block w-full text-sm text-stone-700 file:mr-3 file:rounded-md file:border-0 file:bg-emerald-900 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-emerald-800"
							/>
						</div>
						<button
							type="submit"
							class="inline-flex items-center rounded-md bg-emerald-900 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-emerald-800"
						>
							Upload paper
						</button>
					</form>
					<p id="publish-status" class="mt-4 text-sm text-stone-600"></p>
				</div>
			</section>
		</main>
		@siteFooter(provider.SiteName)
		<script>
			(function() {
				function initPublish() {
					var startBtn = document.getElementById('publish-start');
					var formEl = document.getElementById('publish-form');
					var uploadForm = document.getElementById('publish-upload');
					var statusEl = document.getElementById('publish-status');

					startBtn.addEventListener('click', function() {
						startBtn.disabled = true;
						startBtn.textContent = 'Signing in...';
						ensureSignedIn().then(function() {
							startBtn.classList.add('hidden');
							formEl.classList.remove('hidden');
						}).catch(function(err) {
							if (err && err.code === 'auth/popup-closed-by-user') {
								return;
							}
							showAuthFailedToast('Sign in failed: ' + err.message);
						}).finally(function() {
							startBtn.disabled = false;
							startBtn.textContent = 'Start publishing';
						});
					});

					uploadForm.addEventListener('submit', function(event) {
						event.preventDefault();
						var title = document.getElementById('publish-title').value.trim();
						var fileInput = document.getElementById('publish-file');
						if (!title) {
							showToast('Please enter a paper title');
							return;
						}
						if (!fileInput.files || fileInput.files.length === 0) {
							showToast('Please choose a PDF file');
							return;
						}
						if (fileInput.files[0].type !== 'application/pdf' && !/\.pdf$/i.test(fileInput.files[0].name)) {
							showToast('Please choose a PDF file');
							return;
						}
						if (fileInput.files[0].size > 100 * 1024 * 1024) {
							showToast('File too large, max size is 100 MiB');
							return;
						}

						var formData = new FormData();
						formData.append('title', title);
						formData.append('file', fileInput.files[0]);

						statusEl.textContent = 'Uploading...';
						authFetch('/api/v1/paper', {
							method: 'POST',
							body: formData
						}).then(function(resp) {
							if (resp.status === 201) {
								return resp.json().then(function(data) {
									statusEl.textContent = 'Your paper was submitted for review. Reference: ' + data.uuid;
									uploadForm.reset();
								});
							}
							return resp.text().then(function(text) {
								var message = text;
								try {
									message = JSON.parse(text).error || text;
								} catch (e) {}
								throw new Error(message || 'Upload failed (HTTP ' + resp.status + ')');
							});
						}).catch(function(err) {
							if (isSessionExpiredError(err)) {
								statusEl.textContent = 'Session expired, please sign in again';
								handleSessionExpired();
								return;
							}
							statusEl.textContent = 'Upload failed: ' + err.message;
						});
					});
				}
				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', initPublish);
				} else {
					initPublish();
				}
			})();
		</script>
	</div>
}

templ IndexPage(firebaseClientConfig string) {
	@base(indexInfo, indexPage(), firebaseClientConfig)
}
