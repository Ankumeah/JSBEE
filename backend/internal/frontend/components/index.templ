package components

import (
	"github.com/Ankumeah/JSBEE/backend/internal/provider"
)

var indexInfo = pageInfo{
	title:       provider.SiteName,
	description: provider.SiteDescription,
}

templ indexPage() {
	<div class="flex min-h-screen flex-col">
		@navBar(provider.SiteName, "home")
	<main class="flex-1">
		<section class="jsbee-band bg-[#16211B]">
			<div class="mx-auto flex max-w-5xl gap-8 px-4 py-16 sm:px-6 sm:py-24">
				<div class="hidden flex-col items-center gap-3 sm:flex" aria-hidden="true">
					<span class="block h-2 w-2 rotate-45 bg-[#C9A44A]"></span>
					<span class="w-px flex-1 bg-white/15"></span>
				</div>
				<div class="min-w-0">
					<p class="jsbee-hero-enter font-serif text-lg italic text-[#B9C2B2]">Ideas. Research. Impact.</p>
					<h1 class="jsbee-hero-enter jsbee-d1 mt-4 max-w-3xl font-serif text-5xl font-semibold leading-[1.04] text-[#F2F3EA] sm:text-7xl">
						Your Ideas Can Go Further.
					</h1>
					<p class="jsbee-hero-enter jsbee-d2 mt-6 max-w-2xl text-xl leading-relaxed text-[#B9C2B2]">
						{ provider.SiteDescription }
					</p>
					<div class="jsbee-hero-enter jsbee-d3 mt-9 flex flex-wrap gap-3">
						<a
							href="/volumes"
							class="jsbee-btn inline-flex items-center rounded-[3px] bg-[#F2F3EA] px-6 py-3 text-sm font-bold text-[#16211B] hover:bg-white"
						>
							Explore JSBEE
						</a>
						<a
							href="#publish"
							class="jsbee-btn inline-flex items-center rounded-[3px] border border-[#F2F3EA]/30 px-6 py-3 text-sm font-semibold text-[#F2F3EA] hover:bg-white/10"
						>
							Submit your paper
						</a>
					</div>
					<dl class="jsbee-hero-enter jsbee-d4 mt-12 grid max-w-3xl grid-cols-1 gap-6 border-t border-white/15 pt-7 sm:grid-cols-3">
						<div class="border-l border-[#F2F3EA]/25 pl-4">
							<dt class="font-serif text-lg text-[#F2F3EA]">Free to read</dt>
							<dd class="mt-1 text-sm leading-relaxed text-[#8E9787]">Open access to every paper</dd>
						</div>
						<div class="border-l border-[#F2F3EA]/25 pl-4">
							<dt class="font-serif text-lg text-[#F2F3EA]">Reviewed by editors</dt>
							<dd class="mt-1 text-sm leading-relaxed text-[#8E9787]">Checked before it joins a volume</dd>
						</div>
						<div class="border-l border-[#F2F3EA]/25 pl-4">
							<dt class="font-serif text-lg text-[#F2F3EA]">Organised by volume</dt>
							<dd class="mt-1 text-sm leading-relaxed text-[#8E9787]">Browse issues as they appear</dd>
						</div>
					</dl>
				</div>
			</div>
		</section>
		<section id="stats" class="jsbee-band hidden border-b border-[#DDD5C2] bg-[#F2EDE1]">
			<div class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
				<dl class="grid grid-cols-2 gap-8 md:grid-cols-4">
					<div class="flex flex-col">
						<dt class="order-2 mt-2 text-sm leading-relaxed text-stone-500">Papers published</dt>
						<dd id="stat-papers" class="jsbee-stat-num order-1 font-serif text-4xl font-semibold text-stone-900 sm:text-5xl">0</dd>
					</div>
					<div class="flex flex-col">
						<dt class="order-2 mt-2 text-sm leading-relaxed text-stone-500">Volumes</dt>
						<dd id="stat-volumes" class="jsbee-stat-num order-1 font-serif text-4xl font-semibold text-stone-900 sm:text-5xl">0</dd>
					</div>
					<div class="flex flex-col">
						<dt class="order-2 mt-2 text-sm leading-relaxed text-stone-500">Issues</dt>
						<dd id="stat-issues" class="jsbee-stat-num order-1 font-serif text-4xl font-semibold text-stone-900 sm:text-5xl">0</dd>
					</div>
					<div class="flex flex-col">
						<dt class="order-2 mt-2 text-sm leading-relaxed text-stone-500">Cities represented</dt>
						<dd id="stat-cities" class="jsbee-stat-num order-1 font-serif text-4xl font-semibold text-stone-900 sm:text-5xl">0</dd>
					</div>
				</dl>
			</div>
		</section>
		<section id="latest" class="mx-auto hidden max-w-5xl px-4 pt-14 sm:px-6">
			<div class="flex flex-wrap items-baseline justify-between gap-3">
				<div>
					<p class="font-serif text-lg italic text-stone-500">Fresh off review</p>
					<h2 class="mt-2 font-serif text-3xl font-semibold leading-snug text-stone-900 sm:text-4xl">Latest publications</h2>
				</div>
				<a href="/volumes" class="text-sm font-medium text-[#33523B] hover:underline hover:underline-offset-4">Browse the full library</a>
			</div>
			<ul id="latest-list" class="mt-8 border-t border-[#DDD5C2]"></ul>
		</section>
		<section class="mx-auto max-w-5xl px-4 pt-14 sm:px-6">
			<p class="font-serif text-lg italic text-stone-500">How publishing works</p>
			<h2 class="mt-2 max-w-xl font-serif text-3xl font-semibold leading-snug text-stone-900 sm:text-4xl">Explore. Research. Publish.</h2>
			<ol class="mt-8 grid gap-10 md:grid-cols-3">
				<li class="border-t-2 border-[#33523B] pt-4">
					<span class="font-serif text-lg text-[#33523B]" aria-hidden="true">1</span>
					<h3 class="mt-1 font-semibold text-stone-900">Upload your PDF</h3>
					<p class="mt-1.5 text-sm leading-relaxed text-stone-600">Sign in and submit your title and file through the form below.</p>
				</li>
				<li class="border-t-2 border-[#33523B] pt-4">
					<span class="font-serif text-lg text-[#33523B]" aria-hidden="true">2</span>
					<h3 class="mt-1 font-semibold text-stone-900">Editor review</h3>
					<p class="mt-1.5 text-sm leading-relaxed text-stone-600">Reviewers check quality and fit, then move it to the publish queue.</p>
				</li>
				<li class="border-t-2 border-[#33523B] pt-4">
					<span class="font-serif text-lg text-[#33523B]" aria-hidden="true">3</span>
					<h3 class="mt-1 font-semibold text-stone-900">Published in a volume</h3>
					<p class="mt-1.5 text-sm leading-relaxed text-stone-600">Your paper gets a number and appears under its volume and issue.</p>
				</li>
			</ol>
		</section>
		<section class="mx-auto grid max-w-5xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-2">
			<div class="border-t border-[#DDD5C2] pt-5">
				<h2 class="font-serif text-2xl font-semibold text-stone-900">Aims and scope</h2>
				<p class="jsbee-dropcap mt-4 leading-relaxed text-stone-600">
					JSBEE, the Journal of Sustainable Business in Emerging Economies, is a student-led initiative built to help young people explore ideas, conduct research, share knowledge, and create meaningful opportunities.
					We bring together students interested in Sustainability, Business, Economics, and Emerging Economies, creating a space where curiosity can turn into research and research can turn into impact.
				</p>
				<a href="/about" class="mt-4 inline-block text-sm font-medium text-[#33523B] hover:underline hover:underline-offset-4">More about us</a>
			</div>
			<div class="border-t border-[#DDD5C2] pt-5">
				<h2 class="font-serif text-2xl font-semibold text-stone-900">Built by Students, for Students</h2>
				<p class="mt-4 leading-relaxed text-stone-600">
					We believe students should not have to wait until university to start exploring serious ideas.
					Whether you are writing your first research paper, working on a project, organizing an event, or looking for people who share your interests, JSBEE is a place to start.
				</p>
				<a href="/team" class="mt-4 inline-block text-sm font-medium text-[#33523B] hover:underline hover:underline-offset-4">Meet the team</a>
			</div>
		</section>
		<section id="researchers" class="jsbee-band hidden border-y border-[#DDD5C2] bg-[#F2EDE1]">
			<div class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
				<p class="font-serif text-lg italic text-stone-500">People behind the papers</p>
				<h2 class="mt-2 font-serif text-3xl font-semibold leading-snug text-stone-900 sm:text-4xl">Featured researchers</h2>
				<ul id="researchers-list" class="mt-8 grid gap-x-10 md:grid-cols-2"></ul>
			</div>
		</section>
		<section id="publish" class="jsbee-band scroll-mt-24 bg-[#16211B]">
			<div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
				<p class="font-serif text-lg italic text-[#B9C2B2]">Submissions</p>
				<h2 class="mt-3 max-w-xl font-serif text-3xl font-semibold leading-snug text-[#F2F3EA] sm:text-4xl">Publish your own paper</h2>
				<p class="mt-4 max-w-xl leading-relaxed text-[#B9C2B2]">
					You don't need to be an expert to have an idea worth exploring.
					JSBEE encourages students to question, investigate, write, collaborate, and share their perspectives on issues shaping businesses, economies, communities, and our future.
				</p>
				<button
					id="publish-start"
					type="button"
					class="jsbee-btn mt-7 inline-flex items-center rounded-[3px] bg-[#F2F3EA] px-6 py-3 text-sm font-bold text-[#16211B] hover:bg-white"
				>
					Start publishing
				</button>
			<div
				id="publish-form"
				class="mt-8 hidden max-w-2xl border border-[#F2F3EA]/15 bg-white/5 p-6 sm:p-8"
			>
				<form id="publish-upload" enctype="multipart/form-data" class="space-y-5">
					<div>
						<label
							for="publish-title"
							class="block text-sm font-medium text-[#EDEFE4]"
						>
							Paper title
						</label>
						<input
							id="publish-title"
							type="text"
							name="title"
							required
							placeholder="e.g. Green finance adoption in emerging markets"
							class="mt-1.5 w-full rounded-[3px] border border-[#F2F3EA]/20 bg-[#0E1511] px-3 py-2.5 text-sm text-[#F2F3EA] placeholder:text-[#6E7768] focus:border-[#F2F3EA]/60 focus:outline-none"
						/>
					</div>
					<div>
						<label
							for="publish-location"
							class="block text-sm font-medium text-[#EDEFE4]"
						>
							Location
						</label>
						<input
							id="publish-location"
							type="text"
							name="location"
							required
							maxlength="120"
							placeholder="e.g. Mumbai, India"
							class="mt-1.5 w-full rounded-[3px] border border-[#F2F3EA]/20 bg-[#0E1511] px-3 py-2.5 text-sm text-[#F2F3EA] placeholder:text-[#6E7768] focus:border-[#F2F3EA]/60 focus:outline-none"
						/>
						<p class="mt-1 text-xs text-[#8E9787]">Where the paper was written.</p>
					</div>
					<div>
						<label
							for="publish-category"
							class="block text-sm font-medium text-[#EDEFE4]"
						>
							Category
						</label>
						<input
							id="publish-category"
							type="text"
							name="category"
							required
							maxlength="120"
							placeholder="e.g. Economics"
							class="mt-1.5 w-full rounded-[3px] border border-[#F2F3EA]/20 bg-[#0E1511] px-3 py-2.5 text-sm text-[#F2F3EA] placeholder:text-[#6E7768] focus:border-[#F2F3EA]/60 focus:outline-none"
						/>
						<p class="mt-1 text-xs text-[#8E9787]">The research area, e.g. Sustainability, Business, Economics.</p>
					</div>
					<div>
						<label
							for="publish-file"
							class="block text-sm font-medium text-[#EDEFE4]"
						>
							PDF file
						</label>
						<input
							id="publish-file"
							type="file"
							name="file"
							accept="application/pdf"
							required
							class="mt-1.5 block w-full text-sm text-[#B9C2B2] file:mr-3 file:rounded-[3px] file:border-0 file:bg-[#EDEFE4] file:px-4 file:py-2 file:text-sm file:font-bold file:text-[#16211B] hover:file:bg-white"
						/>
					</div>
					<button
						type="submit"
						class="jsbee-btn inline-flex items-center rounded-[3px] bg-[#EDEFE4] px-6 py-2.5 text-sm font-bold text-[#16211B] hover:bg-white"
					>
						Upload paper
					</button>
				</form>
				<p id="publish-status" class="mt-4 text-sm text-[#B9C2B2]"></p>
			</div>
			</div>
		</section>
		</main>
		@siteFooter(provider.SiteName)
		<script>
			(function() {
				var uuidPattern = /^[0-9a-fA-F-]{36}$/;

				function safeUUID(uuid) {
					return typeof uuid === 'string' && uuidPattern.test(uuid) ? uuid : null;
				}

				function el(tag, className, text) {
					var node = document.createElement(tag);
					if (className) {
						node.className = className;
					}
					if (text != null) {
						node.textContent = text;
					}
					return node;
				}

				function paperHref(paper) {
					var uuid = safeUUID(paper.uuid);
					return uuid ? '/paper?uuid=' + encodeURIComponent(uuid) : null;
				}

				// Papers carry no publication date, so "latest" is derived
				// from position: highest volume, then issue, then number.
				function paperRank(paper) {
					return (paper._volume * 1000000) + (paper._issue * 1000) + (paper.number || 0);
				}

				function flattenVolumes(volumes) {
					var flat = [];
					(volumes || []).forEach(function(volume) {
						((volume && volume.issues) || []).forEach(function(issue) {
							((issue && issue.papers) || []).forEach(function(paper) {
								paper._volume = volume.number || 0;
								paper._issue = issue.number || 0;
								flat.push(paper);
							});
						});
					});
					flat.sort(function(a, b) {
						return paperRank(b) - paperRank(a);
					});
					return flat;
				}

				function resolveAuthorNames(papers, done) {
					var seen = {};
					var uuids = [];
					papers.forEach(function(paper) {
						var uuid = safeUUID(paper.owner_uuid);
						if (uuid && !seen[uuid]) {
							seen[uuid] = true;
							uuids.push(uuid);
						}
					});
					if (!uuids.length) {
						done({});
						return;
					}
					var names = {};
					var pending = uuids.length;
					uuids.forEach(function(uuid) {
						fetchWithRetry('/api/v1/user?uuid=' + encodeURIComponent(uuid))
							.then(function(resp) {
								return checkApiResponse(resp, 'Failed to load author');
							}).then(function(resp) {
								return resp.json();
							}).then(function(data) {
								if (data && data.user && data.user.name) {
									names[uuid] = data.user.name;
								}
							}).catch(function() {}).finally(function() {
								pending -= 1;
								if (pending === 0) {
									done(names);
								}
							});
					});
				}

				function authorName(paper, names) {
					var uuid = safeUUID(paper.owner_uuid);
					return (uuid && names[uuid]) || null;
				}

				// Latest: journal index rows with a dotted leader.
				function latestRow(paper, names) {
					var li = el('li', 'border-b border-[#DDD5C2]');
					var href = paperHref(paper);
					var row = el('div', 'flex items-baseline gap-2');
					var link = el('a', 'jsbee-row-hover flex min-w-0 flex-1 items-baseline gap-3 px-3 py-4');
					if (href) {
						link.href = href;
					} else {
						link.setAttribute('aria-disabled', 'true');
					}
					if (paper.number != null) {
						link.appendChild(el('span', 'shrink-0 text-xs font-semibold text-[#33523B]', 'No. ' + paper.number));
					}
					link.appendChild(el('span', 'font-serif text-lg font-medium text-stone-900', paper.title || 'Untitled'));
					link.appendChild(el('span', 'jsbee-leader', null));
					var name = authorName(paper, names);
					if (name) {
						link.appendChild(el('span', 'shrink-0 text-sm text-stone-500', name));
					}
					row.appendChild(link);
					li.appendChild(row);
					return li;
				}

				function renderStats(papers, volumes, leaders) {
					var issues = 0;
					(volumes || []).forEach(function(volume) {
						issues += ((volume && volume.issues) || []).length;
					});
					var cities = {};
					(leaders || []).forEach(function(leader) {
						if (leader && leader.city_lead) {
							cities[leader.city_lead] = true;
						}
					});
					var section = document.getElementById('stats');
					section.classList.remove('hidden');
					jsbeeCountUp(document.getElementById('stat-papers'), papers.length);
					jsbeeCountUp(document.getElementById('stat-volumes'), volumes.length);
					jsbeeCountUp(document.getElementById('stat-issues'), issues);
					jsbeeCountUp(document.getElementById('stat-cities'), Object.keys(cities).length);
				}

				function renderLatest(papers, names) {
					var rest = papers.slice(0, 5);
					if (!rest.length) {
						return;
					}
					var section = document.getElementById('latest');
					var list = document.getElementById('latest-list');
					rest.forEach(function(paper) {
						list.appendChild(latestRow(paper, names));
					});
					section.classList.remove('hidden');
				}

				function renderResearchers(leaders) {
					var valid = (leaders || []).filter(function(leader) {
						return leader && safeUUID(leader.uuid) && leader.name;
					}).slice(0, 6);
					if (!valid.length) {
						return;
					}
					var section = document.getElementById('researchers');
					var list = document.getElementById('researchers-list');
					valid.forEach(function(leader) {
						var li = el('li', 'border-t border-[#CFC6B0]');
						var link = el('a', 'jsbee-row-hover flex items-baseline justify-between gap-4 px-3 py-5');
						link.href = '/author?uuid=' + encodeURIComponent(leader.uuid);
						link.appendChild(el('span', 'font-serif text-xl font-semibold text-stone-900', leader.name));
						if (leader.city_lead) {
							link.appendChild(el('span', 'shrink-0 text-sm font-medium text-[#33523B]', leader.city_lead));
						}
						li.appendChild(link);
						list.appendChild(li);
					});
					section.classList.remove('hidden');
				}

				function initHome() {
					var volumesReq = fetchWithRetry('/api/v1/paper/volumes')
						.then(function(resp) {
							return checkApiResponse(resp, 'Failed to load volumes');
						}).then(function(resp) {
							return resp.json();
						}).then(function(data) {
							return (data && Array.isArray(data.volumes)) ? data.volumes : [];
						}).catch(function() {
							return [];
						});
					var leadersReq = fetchWithRetry('/api/v1/leaders')
						.then(function(resp) {
							return checkApiResponse(resp, 'Failed to load team');
						}).then(function(resp) {
							return resp.json();
						}).then(function(data) {
							return (data && Array.isArray(data.leaders)) ? data.leaders : [];
						}).catch(function() {
							return [];
						});
					Promise.all([volumesReq, leadersReq]).then(function(results) {
						var volumes = results[0];
						var leaders = results[1];
						var papers = flattenVolumes(volumes);
						if (!papers.length && !leaders.length) {
							return;
						}
						renderStats(papers, volumes, leaders);
						renderResearchers(leaders);
						if (!papers.length) {
							return;
						}
						resolveAuthorNames(papers.slice(0, 5), function(names) {
							renderLatest(papers, names);
						});
					});
				}

				function initPublish() {
					var startBtn = document.getElementById('publish-start');
					var formEl = document.getElementById('publish-form');
					var uploadForm = document.getElementById('publish-upload');
					var statusEl = document.getElementById('publish-status');

					startBtn.addEventListener('click', function() {
						startBtn.disabled = true;
						startBtn.textContent = 'Signing in...';
						showToast('Waiting for login...');
						ensureSignedIn().then(function() {
							hideToast();
							startBtn.classList.add('hidden');
							formEl.classList.remove('hidden');
						}).catch(function(err) {
							hideToast();
							if (err && err.code === 'auth/popup-closed-by-user') {
								return;
							}
							showAuthFailedToast('Sign in failed: ' + err.message);
						}).finally(function() {
							startBtn.disabled = false;
							startBtn.textContent = 'Start publishing';
						});
					});

					uploadForm.addEventListener('submit', function(event) {
						event.preventDefault();
						var title = document.getElementById('publish-title').value.trim();
						var location = document.getElementById('publish-location').value.trim();
						var category = document.getElementById('publish-category').value.trim();
						var fileInput = document.getElementById('publish-file');
						if (!title) {
							showToast('Please enter a paper title');
							return;
						}
						if (!location) {
							showToast('Please enter where the paper was written');
							return;
						}
						if (location.length > 120) {
							showToast('Location must be at most 120 characters');
							return;
						}
						if (!category) {
							showToast('Please enter a category');
							return;
						}
						if (category.length > 120) {
							showToast('Category must be at most 120 characters');
							return;
						}
						if (!fileInput.files || fileInput.files.length === 0) {
							showToast('Please choose a PDF file');
							return;
						}
						if (fileInput.files[0].type !== 'application/pdf' && !/\.pdf$/i.test(fileInput.files[0].name)) {
							showToast('Please choose a PDF file');
							return;
						}

						var file = fileInput.files[0];

						function failUpload(err) {
							if (isSessionExpiredError(err)) {
								statusEl.textContent = 'Session expired, please sign in again';
								handleSessionExpired();
								return;
							}
							statusEl.textContent = 'Upload failed: ' + err.message;
						}

						// Large PDFs go direct to the object store: the
						// backend issues a presigned URL, the browser PUTs
						// the file there, then the backend confirms the
						// private object and creates the paper row.
						statusEl.textContent = 'Requesting upload...';
						authFetchWithRetry('/api/v1/paper/upload-url', {
							method: 'POST'
						}).then(function(resp) {
							return checkApiResponse(resp, 'Could not start upload');
						}).then(function(resp) {
							return resp.json();
						}).then(function(data) {
							if (!data || !data.uuid || !data.upload_url) {
								throw new Error('Upload failed: bad upload response');
							}
							statusEl.textContent = 'Uploading, please wait a minute...';
							return fetchWithRetry(data.upload_url, {
								method: 'PUT',
								headers: { 'Content-Type': 'application/pdf' },
								body: file
							}).then(function(putResp) {
								return checkApiResponse(putResp, 'Upload failed');
							}).then(function() {
								return data.uuid;
							});
						}).then(function(paperUUID) {
							statusEl.textContent = 'Confirming...';
							return authFetchWithRetry('/api/v1/paper/confirm', {
								method: 'POST',
								headers: { 'Content-Type': 'application/json' },
								body: JSON.stringify({ uuid: paperUUID, title: title, location: location, category: category })
							}).then(function(resp) {
								return checkApiResponse(resp, 'Could not confirm upload');
							});
						}).then(function(resp) {
							return resp.json();
						}).then(function(data) {
							if (!data || !data.uuid) {
								throw new Error('Upload failed: missing paper reference');
							}
							statusEl.textContent = 'Your paper was submitted for review. Reference: ' + data.uuid;
							uploadForm.reset();
						}).catch(failUpload);
					});
				}
				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', function() {
						initHome();
						initPublish();
					});
				} else {
					initHome();
					initPublish();
				}
			})();
		</script>
	</div>
}

templ IndexPage(firebaseClientConfig map[string]any) {
	@base(indexInfo, indexPage(), firebaseClientConfig)
}
