<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Your paper is published</title>
</head>

<body style="margin:0;padding:0;background-color:#E9EBE0;font-family:Arial,Helvetica,sans-serif;color:#44403c;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
    style="background-color:#E9EBE0;padding:24px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0"
          style="max-width:600px;width:100%;background-color:#F5F6EF;border:1px solid #D3D8C6;">
          <tr>
            <td style="background-color:#16211B;padding:28px 32px;">
              <p
                style="margin:0;font-family:Georgia,'Times New Roman',serif;font-size:28px;font-weight:700;color:#F2F3EA;letter-spacing:-0.5px;">
                {{.SiteName}}</p>
              <p
                style="margin:6px 0 0;font-family:Georgia,'Times New Roman',serif;font-size:15px;font-style:italic;color:#B9C2B2;">
                {{.SiteDescription}}</p>
            </td>
          </tr>
          <tr>
            <td style="background-color:#C9A44A;height:4px;line-height:4px;font-size:0;">&nbsp;</td>
          </tr>
          <tr>
            <td style="padding:32px 32px 8px;">
              <span
                style="display:inline-block;background-color:#C9A44A;color:#16211B;font-size:12px;font-weight:700;letter-spacing:1px;text-transform:uppercase;padding:6px 14px;border-radius:3px;">Published</span>
              <h1
                style="margin:18px 0 0;font-family:Georgia,'Times New Roman',serif;font-size:26px;line-height:1.25;color:#1c1917;">
                Congratulations {{.AuthorName}}! Your paper is live</h1>
            </td>
          </tr>
          <tr>
            <td style="padding:8px 32px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                style="border-left:3px solid #C9A44A;background-color:#FFFFFF;">
                <tr>
                  <td
                    style="padding:14px 18px;font-family:Georgia,'Times New Roman',serif;font-size:17px;color:#1c1917;">
                    {{.PaperTitle}}</td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding:20px 32px 0;font-size:15px;line-height:1.7;color:#44403c;">
              <p style="margin:0 0 12px;">Your paper ({{.PaperTitle}}) has been published in {{.SiteName}} and is now free for
                anyone to read and download. Thank you for sharing your research with the community.</p>
            </td>
          </tr>
          <tr>
            <td style="padding:24px 32px 0;">
              <table role="presentation" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="background-color:#33523B;border-radius:3px;">
                    <a href="{{.VolumesLink}}"
                      style="display:inline-block;padding:12px 26px;font-size:14px;font-weight:700;color:#F5F6EF;text-decoration:none;">Browse
                      volumes</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding:24px 32px 32px;font-size:15px;line-height:1.7;color:#44403c;">
              <p style="margin:0;">Warm regards,<br /><span
                  style="font-family:Georgia,'Times New Roman',serif;font-weight:700;color:#33523B;">The {{.SiteName}} editorial
                  team</span></p>
            </td>
          </tr>
          <tr>
            <td style="background-color:#16211B;padding:20px 32px;">
              <p
                style="margin:0;font-family:Georgia,'Times New Roman',serif;font-size:16px;font-weight:700;color:#F2F3EA;">
                {{.SiteName}}</p>
              <p style="margin:4px 0 0;font-size:12px;line-height:1.6;color:#8E9787;">A student-led platform for
                the next generation of thinkers. You received this email because you submitted a
                paper to {{.SiteName}}.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>

</html>
