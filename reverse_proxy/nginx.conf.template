worker_processes auto;
events { worker_connections 1024; }

http {
  include /etc/nginx/mime.types;

  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_comp_level 6;
  gzip_types text/plain text/css text/xml text/javascript application/javascript application/xml application/json application/rss+xml image/svg+xml;

  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header X-Frame-Options "SAMEORIGIN" always;

  upstream backend_cluster {
    server $HOSTNAME:$BACKEND_PORT;
  }

  server {
    listen $REVERSE_PROXY_PORT;
    server_name "";

    location /api/$API_VERSION {
      proxy_pass http://backend_cluster;

      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
    }

    location /api/$API_VERSION/paper {
      proxy_pass http://backend_cluster;

      client_max_body_size 100m;
      proxy_request_buffering off;

      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
    }

    location /api/$API_VERSION/blog {
      proxy_pass http://backend_cluster;

      client_max_body_size 10m;
      proxy_request_buffering off;

      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
    }

    location /api/$API_VERSION/admin/blog {
      proxy_pass http://backend_cluster;

      client_max_body_size 10m;
      proxy_request_buffering off;

      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
    }

    location /api/$API_VERSION/admin/about {
      proxy_pass http://backend_cluster;

      client_max_body_size 10m;
      proxy_request_buffering off;

      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
    }

    location = / {
      root /data/public/;
      index index.html;
      # HTML changes on every publish: revalidate, never serve stale.
      add_header Cache-Control "public, max-age=0, must-revalidate" always;
    }

    location ~ ^/(robots\.txt|sitemap\.xml)$ {
      root /data/public/;
      add_header Cache-Control "public, max-age=3600" always;
    }

    location / {
      root /data/public/;
      add_header Cache-Control "public, max-age=0, must-revalidate" always;
      try_files $uri $uri.html =404;
      error_page 404 /not_found.html;
    }
  }
}
