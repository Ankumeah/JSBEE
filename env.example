API_VERSION=v1
BACKEND_PORT=5000
REVERSE_PROXY_PORT=8000

HOSTNAME=api-server # Change to localhost if using root Dockerfile
DB_URL=file:///data/jsbee.sql?_pragma=foreign_keys(ON)&_pragma=busy_timeout(5000)

FIREBASE_CREDENTIALS=firebase_key
FIREBASE_CLIENT_CONFIG=firebase_client_config

OBJECT_STORE_CONFIG={"access_key":"","secret_key":"","region":"","max_db_snapshots":2,"url":"","secure":true}

FRONTEND_SAVE_DIR=/data/public/
